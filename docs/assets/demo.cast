[2.695, "o", "\u001b[2J\u001b[H\r\n$ # Done - real install + deploy instructions\r\n\r\n  real install:  pip install nocoly-explorer[service,streaming,async]\r\n  real deploy:   arq nocoly_explorer.service.worker.WorkerSettings\r\n                  uvicorn nocoly_explorer.service:app --host 127.0.0.1 --port 8080\r\n"]
